 #pragma mark - UIView methods
 
+- (void)layoutSubviews
+{
+  [super layoutSubviews];
+
+  if (CGSizeEqualToSize(self.bounds.size, _lastLayoutSize)) {
+    return;
+  }
+  _lastLayoutSize = self.bounds.size;
+
+  // React resizes the host on its own schedule, which can be after UIKit's last layout pass for a size change
+  // (see -[RNSTabBarController viewWillTransitionToSize:withTransitionCoordinator:]). Ask for another pass
+  // once this one is over.
+  RNSTabBarController *controller = _controller;
+  dispatch_async(dispatch_get_main_queue(), ^{
+    [controller.view setNeedsLayout];
+    [controller.tabBar setNeedsLayout];
+  });
+}
