    "build": "tsc",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "html-entities": "^2.6.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.14.1",
    "tsx": "^4.23.15",
    "typescript": "^5.8.3"
  }
}
